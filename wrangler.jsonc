{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aedes",
  "main": "src/api/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": [
      "/static/*"
    ]
  }
}